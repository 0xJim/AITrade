[Unit]
Description=S24 Ignition Paper Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/AITrade
ExecStart=/home/ubuntu/.hermes/hermes-agent/venv/bin/python3 strategies/S24-ignition/s24_paper_trader.py --loop --interval 60 --max-entry-lag-sec 120
Restart=always
RestartSec=10
StandardOutput=append:%h/AITrade/strategies/S24-ignition/logs/s24_paper.log
StandardError=append:%h/AITrade/strategies/S24-ignition/logs/s24_paper.log

[Install]
WantedBy=default.target
